# =============================================================================
#  wecms-api — environment variables (MASTER REFERENCE / shared .env)
# =============================================================================
#  Spring Boot auto-loads env files via spring.config.import (application.yml):
#    ./.env         shared, all profiles      <- copy from THIS file (optional)
#    ./.env.local   local profile             <- .env.local.example
#    ./.env.sit     sit profile               <- .env.sit.example
#    ./.env.uat     uat profile               <- .env.uat.example
#    ./.env.prod    prod profile              <- .env.prod.example
#  All .env / .env.* are gitignored EXCEPT the *.example templates.
#  OS environment variables ALWAYS override .env files (use them on servers).
#  This file lists EVERY WECMS_* key grouped by feature with purpose + valid
#  values; per-profile defaults live in the matching .env.<profile>.example.
#  .env is a properties file — comments on their own line only (no inline "# ...").
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────
# Postgres JDBC, same trio in every profile. No YAML default -> fail fast.
# URL = jdbc:postgresql://<host>:<port>/<db>. PASSWORD is a secret.
WECMS_DB_URL=
WECMS_DB_USERNAME=
WECMS_DB_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────
# HS256/HS512 signing secret. >=32 bytes (HS256); >=64 -> HS512 (preferred).
# Generate: openssl rand -hex 64. Unique per env; dev placeholder is blocklisted.
WECMS_JWT_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated EXACT allowed origins (scheme+host+port). Never "*".
WECMS_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Coocon (smart-gateway: bank/card scraping + FX rate) ───────────────────
# *_API_KEY / *_SMART_API_KEY are SECRETS (required on sit/uat/prod). URLs differ
# DEV vs PROD host. UNIQUE_KEY is a non-secret Coocon client id (e.g. 0000099).
WECMS_COOCON_API_KEY=
WECMS_COOCON_API_URL=
WECMS_COOCON_SMART_API_KEY=
WECMS_COOCON_SMART_API_URL=
WECMS_COOCON_UNIQUE_KEY=

# ── OSMC (GDT business-registration lookup; same Coocon bigdata gateway) ────
# API_KEY is a SECRET. URL/API_ID(e.g. BI09)/UNIQUE_KEY non-secret.
WECMS_OSMC_URL=
WECMS_OSMC_API_KEY=
WECMS_OSMC_API_ID=
WECMS_OSMC_UNIQUE_KEY=

# ── Login Credentials ─────────────────────────────────────────────────────
# GDT (tax-portal) verify-before-save. true|false. Needs reachable GDT gateway +
# captcha challenge-chain; keep false until both exist.
WECMS_LOGIN_CREDENTIALS_GDT_VERIFY_ENABLED=false

# ── Exchange Rate Batch ───────────────────────────────────────────────────
# true|false. Shinhan+Woori FX scraping @Scheduled job (writes BANK_EXCH_RATE_INFM).
# Set true in EXACTLY ONE environment that owns FX collection (SIT today); false
# elsewhere to avoid double-write/races on a shared DB. Depends on Coocon.
WECMS_EXCHANGE_RATE_BATCH_ENABLED=false

# ── Banking Cutoff ────────────────────────────────────────────────────────
# Internal-transfer cut-off bank codes (effective constants; cut-off TIME windows
# stay in YAML). Override only if a bank's code changes.
WECMS_SHINHAN_BANK_CD=88886000
WECMS_WOORI_BANK_CD=11704000

# ── Dispatch (firm-banking payment dispatch via EFS/VAN) ───────────────────
# Flags true|false; cron is a Spring cron expr or "-" (= never fire). All OFF
# until SFTP+EFS+VAN are provisioned. Depends on the EFS + SFTP groups.
# AUTO_RECEIVE: File-path dispatch -> 00301 reception (needs SFTP+EFS)
WECMS_DISPATCH_AUTO_RECEIVE=false
# REALTIME_DISPATCH: real-time 202 dispatch, VND/API (needs VAN keys+EFS)
WECMS_DISPATCH_REALTIME_DISPATCH=false
# RECIPIENT_INQUIRY: depositor-name inquiry WGVN_EFS_201 (needs VAN+EFS)
WECMS_DISPATCH_RECIPIENT_INQUIRY=false
# RESULT_CHECK_CRON: result-check poll; set a cron only in the env owning realtime traffic
WECMS_DISPATCH_RESULT_CHECK_CRON=-
# CALLBACK_ALLOWED_IPS: inbound EFS callback source-IP allow-list (comma-separated); empty = no IP gate (rely on VV crypto)
WECMS_CALLBACK_ALLOWED_IPS=

# ── EFS / VAN gateway ─────────────────────────────────────────────────────
# ENABLED true|false (false = mock/inert). BASE_URL = gateway host (DEV:
# https://dev-van-gw.webcashvietnam.com). PARTNER_ID from ops. Used only when
# ENABLED=true. The per-VAN API key is NOT here — it lives in TB_VAN_API_INFO.
WECMS_EFS_ENABLED=false
WECMS_EFS_BASE_URL=
WECMS_EFS_PARTNER_ID=

# ── SFTP (bulk-file channel: 00301 upload / 01302 result download) ─────────
# ENABLED true|false (false = MockSftp). KEY_PATH points at a private-key file
# (key material NEVER committed); PASSWORD is a secret alt. REMOTE_* are legacy
# dir names (sdata / rdata / rdata/success); PORT legacy 3300. Used when ENABLED=true.
WECMS_SFTP_ENABLED=false
WECMS_SFTP_HOST=
WECMS_SFTP_PORT=3300
WECMS_SFTP_USERNAME=
WECMS_SFTP_KEY_PATH=
WECMS_SFTP_PASSWORD=
WECMS_SFTP_LOCAL_UPLOAD=
WECMS_SFTP_REMOTE_UPLOAD=sdata
WECMS_SFTP_LOCAL_DOWNLOAD=
WECMS_SFTP_REMOTE_DOWNLOAD=rdata
WECMS_SFTP_REMOTE_MOVE=rdata/success

# ── Storage Roots (file uploads; layout <root>/<bizKey>/<module>/<file>) ────
# One root per upload module. Point at persistent disk (never ./tmp on a server).
# Bare/fail-fast on uat/prod; local/sit supply real paths too. Must exist + be writable.
WECMS_INTERNAL_TRANSFER_STORAGE_ROOT=
WECMS_VENDOR_PAYMENT_STORAGE_ROOT=
WECMS_EXPENSE_PAYMENT_STORAGE_ROOT=
WECMS_PAYROLL_STORAGE_ROOT=
WECMS_OVERSEAS_PAYMENT_STORAGE_ROOT=
WECMS_CONTACTS_STORAGE_ROOT=
WECMS_PREFERENCES_STORAGE_ROOT=
WECMS_USER_IMAGE_STORAGE_ROOT=
WECMS_ERP_TRANSACTION_HISTORY_STORAGE_ROOT=

# ── Credential cipher seed (legacy pgcrypto compatibility CONSTANT) ────────
# AES key-derivation seed for BANK_CERT_INFO / GDT_CERT_INFO. Cross-system
# CONSTANT — MUST equal the legacy seed everywhere or cert data can't be shared.
# Has a YAML default (wabooksvn); set here only if the project owner changes it.
WECMS_CRYPTO_LEGACY_CERT_SEED=wabooksvn

# ── HAENGSUNG Oracle ERP integration (PRDT_TYPE='H'; Step 1 foundation) ────
# Secondary, OPTIONAL Oracle datasource. ENABLED true|false (default false).
# When false the app boots against PostgreSQL only — no Oracle bean is created.
# URL/USERNAME/PASSWORD are SECRETS — required ONLY when ENABLED=true (fail-fast
# otherwise). NEVER commit real values; placeholders only. URL form:
# jdbc:oracle:thin:@//<host>:1521/<service>.
HAENGSUNG_ORACLE_ENABLED=false
HAENGSUNG_ORACLE_URL=
HAENGSUNG_ORACLE_USERNAME=
HAENGSUNG_ORACLE_PASSWORD=
# Scheduled Oracle jobs (Steps 3/6/7). All OFF by default; also no-op unless
# HAENGSUNG_ORACLE_ENABLED=true. *_CRON is a Spring cron expr (ICT); 5-min default.
HAENGSUNG_SCHEDULED_IMPORT_ENABLED=false
HAENGSUNG_SCHEDULED_IMPORT_CRON=0 */5 * * * *
HAENGSUNG_EXCHANGE_RATE_SYNC_ENABLED=false
HAENGSUNG_EXCHANGE_RATE_SYNC_CRON=0 */5 * * * *
HAENGSUNG_CARD_ACCOUNT_SYNC_ENABLED=false
HAENGSUNG_CARD_ACCOUNT_SYNC_CRON=0 */5 * * * *

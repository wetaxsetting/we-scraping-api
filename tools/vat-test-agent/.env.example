# Sao chép thành .env (hoặc export trực tiếp) trước khi chạy.

# --- Backend đang chạy (bootRun) ---
WECMS_API_BASE=http://localhost:8080
WECMS_USER_ID=testuser
WECMS_USER_PW=Password!1

# --- Chỉ cần cho agent.py (không cần cho run_deterministic.py) ---
ANTHROPIC_API_KEY=sk-ant-...
VAT_AGENT_MODEL=claude-sonnet-5
VAT_AGENT_MAX_CASES=40

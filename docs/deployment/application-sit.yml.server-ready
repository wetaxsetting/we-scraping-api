# =============================================================================
# SIT PROFILE — system integration test host
# =============================================================================
# VALUES LIVE IN .env.sit, NEVER HERE. This file declares shape only; every
# value is ${VAR}. See application.yml's header for the full contract.
#
# THE RULE — one form only: EVERY placeholder is bare ${VAR}, no yml defaults.
#   EVERY ${VAR} IN THIS FILE MUST BE SET IN .env.sit, or startup fails.
# 72 variables for this profile (this file plus application.yml). The
# authoritative checklist is .env.sit.example — every variable that profile
# needs, carrying the value the yml used to default to. Migrated 2026-07-30; see
# docs/deployment/config-bare-placeholder-migration.md and application.yml's header.
#
# >>> DEPLOY ORDER: the host .env (setenv.sh / OS env) MUST be updated BEFORE this
# >>> yml is deployed. Old .env + new yml = the app does not start.
#
# Empty satisfies a String but not a boolean/int (WECMS_SFTP_PORT= fails). Where the
# correct value IS empty (WECMS_SFTP_USERNAME, WECMS_CALLBACK_TRUSTED_PROXIES,
# WECMS_DISPATCH_ALERT_WAS_NO) the line must still exist, with nothing after '='.
#
# ACCURACY NOTE — a missing variable does NOT always say so. @Value and @Scheduled
# properties abort naming the variable ("Could not resolve placeholder 'VAR'"), but
# @ConfigurationProperties binds LENIENTLY: the literal text "${VAR}" becomes the
# value. A boolean/int target then fails the bind (verified:
# 'wecms.dispatch.callback.trust-forwarded-for' -> Value: "${WECMS_CALLBACK_TRUST_FORWARDED_FOR}"),
# but a STRING target produces NO error and surfaces later as something unrelated
# (a missing WECMS_JWT_SECRET reported "must be at least 32 bytes (current length:
# 19)" — the length of the text "${WECMS_JWT_SECRET}"). So a complete .env matters
# MORE under this convention, not less: diff the host .env against the .example.
#
# The 13 code-only properties (@Value defaults, in no yml and no .env) are NOT
# covered by this rule — they keep their in-code defaults. Listed, commented out,
# at the end of .env.sit.example.
#
# CRON QUOTING: "-" is Spring's never-fire marker, and it must now be written out in
# the .env — there is no default to fall back on. Cron placeholders stay quoted;
# result-check.cron and recovery.cron are unquoted in all four profiles. Quoting was
# untouched by the migration. Do not change it.
# LOADING — AND WHY THIS FILE'S .env IS NOT THE RUNTIME AUTHORITY:
# spring.config.import below is "optional:", so a MISSING .env.sit does not
# fail — it boots, every default applies, and the first bare ${VAR} aborts with
# an error that never mentions the missing file. On the SIT host the pair lives
# at
#   /DATA/src-wecms/wecms-backend/environment/
# and is loaded by
#   /DATA/src-wecms/apache-tomcat-11.0.22/bin/setenv.sh
# which exports them as OS environment variables before Tomcat starts. That file
# is host-owned and NOT in this repository. OS env OVERRIDES .env files, so
# setenv.sh wins on SIT. Never state SIT's flag state from the repo — read it
# from the host:
#   env | grep -E '^(WECMS|HAENGSUNG)_'
# This has bitten before: DB evidence showed recipient-inquiry and efs.enabled
# live on a deployed SIT node while the committed files said false.
#
# HOW THIS PROFILE DIFFERS: SIT and UAT are the two profiles with the read-only
# stuck-monitor and ops alerting ON in the shipped .env (FIX H / FIX I / FIX K,
# 2026-07-30). SIT differs from UAT only in alert.env-mode (T vs U), verbose SQL
# logging (show-sql: true, DEBUG/TRACE levels), and no server.error hardening.
# Every mutating dispatch leg is still off.
# =============================================================================
spring:
  config:
    import: optional:file:/DATA/src-wecms/wecms-backend/environment/.env.sit[.properties]
  # Database connection.
  datasource:
    url: ${WECMS_DB_URL}
    username: ${WECMS_DB_USERNAME}
    password: ${WECMS_DB_PASSWORD}
    driver-class-name: org.postgresql.Driver
  # JPA and Hibernate behavior.
  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: true
    properties:
      hibernate.format_sql: true

# =============================================================================
# WeCMS application configuration
# Configures security, integrations, file storage, and application services.
# =============================================================================
wecms:
  # JWT authentication.
  jwt:
    secret: ${WECMS_JWT_SECRET}
  # Cross-origin request settings.
  cors:
    allowed-origins: ${WECMS_CORS_ALLOWED_ORIGINS}
  # Credential encryption.
  crypto:
    legacy-cert-seed: ${WECMS_CRYPTO_LEGACY_CERT_SEED}

  # Firm-banking dispatch through EFS and VAN Center.
  #
  # ---------------------------------------------------------------------------
  # TURNING EVERY FLAG BELOW OFF DOES NOT MAKE THE SYSTEM INERT.
  # ---------------------------------------------------------------------------
  # The flags gate DISPATCH, not row creation. Saving a payment writes its
  # TB_PAY_TARGET / TB_PAY_FILE_MST row with PROC_STAT='9' (WAIT) at request
  # time, unconditionally — the five *DispatchExecutor classes set
  # PROC_STAT_PENDING = "9" with no flag consulted. Only the after-commit
  # registrars (RealtimeDispatchRegistrar, DispatchAutoReceiveRegistrar) read a
  # flag, and all they decide is whether THIS application hands the row onward.
  #
  # The row still exists, still says "ready to send". On a SHARED JEX database
  # the legacy batch (FILE_DEPOSIT_TRANSFER_BATCH1, schedule */1 * * * *) polls
  # for exactly PROC_STAT='9' and WILL PICK IT UP AND SEND IT — within 60
  # seconds. "All our flags are off" is NOT the same statement as "no money
  # moves". Before relying on the flags for safety, establish whether this
  # environment's DB is the legacy JEX batch DB.
  #
  # "-" IS SPRING'S NEVER-FIRE MARKER, and the only safe way to disable a cron.
  # An EMPTY value or an invalid expression throws at scheduler initialisation,
  # not at fire time — the app fails to start. Never blank a cron to turn a job
  # off; set it to "-".
  #
  # DB PRECONDITION — TB_BATCH_SCHEDULE_INFO / _DTL must be seeded. With no INFO
  # row OperatingHoursService returns NO_CRITERIA and both BulkReceptionService
  # and RealtimeDispatchService FAIL the row: 100% of transfers fail before any
  # gateway call. Seeded and verified on DEV/SIT (3 INFO + 12 DTL); NOT yet
  # seeded on UAT/PROD. Do not seed from here — the seed is a manual DBA script
  # and, on a shared DB, editing a window is a LEGACY incident. Gate B of
  # docs/deployment/wecms-batch-activation-runbook.md §5.0 owns the procedure.
  # ---------------------------------------------------------------------------
  dispatch:
    auto-receive: ${WECMS_DISPATCH_AUTO_RECEIVE}
    realtime-dispatch: ${WECMS_DISPATCH_REALTIME_DISPATCH}
    recipient-inquiry: ${WECMS_DISPATCH_RECIPIENT_INQUIRY}
    # Result-check polling. MUST stay OFF while legacy PROCESSING_RESULT_CHECK_BATCH
    # is active against the same DB — both drive TB_FIRM_TRAN/TB_PAY_TARGET PROC_STAT
    # and ShedLock cannot coordinate with the legacy runtime.
    result-check:
      # Master gate, OFF in the shipped .env — same double-gate shape as recovery.enabled and
      # stuck-monitor.enabled. BOTH this flag and the cron must be set for the sweep to run.
      # This flag ALSO silences StrandedRecoveryService. That sweep covers four
      # strand classes and delegates the fourth (aged TB_FIRM_TRAN 202/'6') into
      # ResultCheckService.runOnce(). With result-check.enabled=false the
      # delegation is skipped even when recovery.enabled=true — recovery then
      # runs a PARTIAL pass (pay-target + pay-file legs only) and says so at
      # WARN. Do not read "recovery is on" as "all four classes are covered".
      enabled: ${WECMS_DISPATCH_RESULT_CHECK_ENABLED}
      # Unquoted here (and in all four profiles) while every other cron placeholder
      # is quoted — see the header. Do not change the quoting.
      cron: ${WECMS_DISPATCH_RESULT_CHECK_CRON}
      # H-2: candidate rows per pass. Bounds memory and the number of sequential EFS 203
      # round-trips one pass makes (and so how long it holds its ShedLock). Non-positive
      # falls back to 100 rather than aborting the scheduler.
      #
      # COUPLED TO ResultCheckJob's lockAtMostFor — do not change one alone.
      # Processing is strictly sequential and the worst case per row is ~26 s
      # (3 s connect + 20 s read + 3000 ms Woori pacing). At the current 100 that
      # is 100 x 26 s = 43.3 min of worst-case work, held under a PT60M lock
      # ceiling (~38% headroom). Raising batch-size without raising the ceiling
      # lets a still-running pass lose its lock so a second node starts a
      # concurrent pass on the same live payment rows — the exact thing the lock
      # exists to prevent. Recompute as
      #   batchSize x (connectTimeoutMs + readTimeoutMs + worstPaceMs) + headroom
      # and update ResultCheckLockCeilingTest, which asserts the relationship
      # rather than the literal number.
      batch-size: ${WECMS_DISPATCH_RESULT_CHECK_BATCH_SIZE}
    # R-1 stranded-record recovery safety net (Item 4).
    # DISABLED in the shipped .env — keep OFF until legacy-JEX coexistence is resolved (see StrandedRecoveryService).
    recovery:
      enabled: ${WECMS_DISPATCH_RECOVERY_ENABLED}
      cron: ${WECMS_DISPATCH_RECOVERY_CRON}
      grace-minutes: ${WECMS_DISPATCH_RECOVERY_GRACE_MINUTES}
    # Read-only stuck-pay-file monitor. ENABLED IN SIT (via .env) (C-14 / batch-1 follow-up).
    #
    # It performs NO writes — no PROC_STAT change, no re-drive, no dispatch. The "OFF by default like
    # every other scheduler" stance it used to share with recovery.enabled was inherited from a
    # MUTATING sweep and does not apply: the reason recovery must stay off is legacy-JEX coexistence
    # on a shared DB, and a read-only sweep cannot cause that harm.
    #
    # After the batch-1 fail-closed fix this is the ONLY detection for two states that resolve
    # exclusively by human action, because neither has an automatic retry and neither is safe to
    # re-drive blindly:
    #   * BULK_EXECUTION_UNCONFIRMED  — a 00302 was issued and never confirmed (transient 00302
    #                                   failure: the marker committed, nothing re-drives it). The bank
    #                                   MAY already have executed the batch.
    #   * BULK_EXECUTION_NOT_ISSUED   — the afterCommit residual: the JVM died between the commit and
    #                                   the post-commit hook, so no 00302 was ever sent.
    # Leaving this off means both states are invisible until someone queries TB_FIRM_FILE_MST by hand.
    # Procedure for each: docs/deployment/bulk-file-reconciliation-procedure.md.
    #
    # Alerting is ON in SIT — see the alert: block below. Even with it off the sweep still logs
    # (grep "feature=stuck-pay-file-monitor").
    #
    # THE RULE, stated plainly: read-only is WHY this is the one scheduler
    # allowed to be enabled by committed config. It is
    # @Transactional(readOnly = true) with no PROC_STAT write, no re-drive and no
    # dispatch. Every OTHER scheduler stays off in committed config because it
    # mutates rows the live JEX batch also drives on a shared DB, and ShedLock
    # does NOT coordinate with the legacy runtime — coexistence is settled by
    # disabling one side, never by the lock.
    #
    # THE EXCEPTION: local and prod keep it OFF (false + "-"). Local because
    # there is nothing to observe on a laptop; prod because prod has not received
    # this change yet — see application-prod.yml's header. If you add a new gate
    # to this block, give it a .env line and an example entry too: absence is not the mechanism.
    stuck-monitor:
      enabled: ${WECMS_DISPATCH_STUCK_MONITOR_ENABLED}
      # Every 5 minutes. The threshold is 15 min, so a stuck file is reported within ~20 min of
      # becoming stuck; one aggregated alert per sweep, de-duplicated by fingerprint.
      cron: "${WECMS_DISPATCH_STUCK_MONITOR_CRON}"
      # Cap on the second (firm-file) sweep, so monitoring cannot become an unbounded scan.
      firm-file-batch-size: ${WECMS_DISPATCH_STUCK_MONITOR_FIRM_FILE_BATCH_SIZE}
      # FIX H — how far back the firm-file sweep looks, on PROC_DTTM. Replaces the old
      # "TRAN_DT = today" scope, under which a file stranded at 23:59 disappeared at 00:00 and was
      # never reported again. 7 days so a Friday-night strand is still reported on Monday.
      retention-days: ${WECMS_DISPATCH_STUCK_MONITOR_RETENTION_DAYS}
    # Dispatch failure alerts — ops Slack channel WECMSBATCH via the VAN gateway (WGVN_MSG_SEND_001).
    #
    # ENABLED IN SIT (FIX I, 2026-07-30). Previously false, which made every ops alert in the
    # dispatch package a no-op — including StuckPayFileMonitorService's, the ONLY detection for the
    # two manual-reconciliation states the stuck-monitor block above exists to surface. Enabling the
    # monitor while leaving this off meant the detection reached a log file and nobody else.
    #
    # >>> THIS FLAG ALONE DOES NOT DELIVER. The full chain is:
    #       1. wecms.dispatch.alert.enabled=true      <- this line
    #       2. wecms.dispatch.efs.enabled=true + base-url  <- BELOW, still false (B1)
    #       3. TB_VAN_API_INFO.API_KEY row for the alert's VAN_ORG_CD (B2)
    #     With (2) unset, OpsAlertService builds the envelope and calls MockEfsApiClient, which
    #     THROWS; the service swallows it and logs "ops-alert send failed vanOrgCd=… — swallowed".
    #     So until EFS is enabled this flag converts silence into a visible WARN per alert — which is
    #     the point: a missing alert channel should be loud, not invisible. It becomes real delivery
    #     the moment (2) and (3) are in place, with no further config change.
    #
    # Safe to enable ahead of EFS: notify() is @Async on a dedicated executor, wraps its whole body
    # in try/catch and never propagates, so a failing alert cannot affect a dispatch (legacy parity).
    #
    # SCOPE: this one flag gates EVERY ops alert in the dispatch package. It is a
    # single master gate inside OpsAlertService — false makes notify() return
    # before an envelope is even built, and all 11 producers route through it
    # (BulkReception, BulkExecution/ReceptionResult, RealtimeDispatch,
    # ResultCheck, DepositorInquiry, OperatingHours, FixedLengthCodec,
    # StuckPayFileMonitor, ...). With it false every alert in the subsystem is a
    # log line and nothing else.
    alert:
      enabled: ${WECMS_DISPATCH_ALERT_ENABLED}
      # Legacy ENV_MODE marker (T=DEV / U=UAT / R=PROD) + WAS_NO, shown in the alert's ServerGB label.
      # Unset falls back to the active Spring profile, so the label is never blank.
      env-mode: ${WECMS_DISPATCH_ALERT_ENV_MODE}
      was-no: ${WECMS_DISPATCH_ALERT_WAS_NO}
      # FIX K — gateway channel-mapping id. Legacy passes this as a PARAMETER (all 10 call sites
      # happen to send WECMSBATCH), so the protocol accepts any channel the VAN gateway has
      # registered. Defaulted to the legacy value: nothing changes until someone sets it. SIT is the
      # right place to trial a separate channel — but confirm the value with the VAN Center first, or
      # the gateway most likely drops the message silently (fire-and-forget; only a non-0000 RC logs).
      # A blank value falls back to WECMSBATCH.
      #
      # >>> DO NOT change this away from WECMSBATCH until the VAN Center has
      # >>> confirmed that a second channel is actually REGISTERED. An
      # >>> unregistered grpID most likely means the gateway drops the message
      # >>> silently — and because this path is fire-and-forget, the only trace
      # >>> would be a non-0000 RC in the log. You would lose alerts and see
      # >>> nothing fail. WGVN_MSG_SEND_001 is not specified in any vendor
      # >>> document in this workspace, so the registered channel set cannot be
      # >>> answered from the code — it is a VAN-side question.
      grp-id: ${WECMS_DISPATCH_ALERT_GRP_ID}
    # VAN callback access control.
    callback:
      # H-1 — FAIL CLOSED. ENFORCE means an empty or non-matching allow-list rejects with 403.
      # Previously an empty list disabled the filter entirely, so a forgotten variable silently
      # accepted callbacks from anywhere while appearing protected. Overriding to DISABLED in a
      # deployed environment is a security decision and is logged as a WARN on every startup.
      protection: ${WECMS_CALLBACK_PROTECTION}
      # X-Forwarded-For is honoured ONLY when the immediate peer is listed in trusted-proxies.
      # An empty trusted-proxies list therefore ignores the header entirely — a forged header
      # cannot influence the decision. Name the reverse proxy here if TLS terminates upstream.
      trust-forwarded-for: ${WECMS_CALLBACK_TRUST_FORWARDED_FOR}
      trusted-proxies: ${WECMS_CALLBACK_TRUSTED_PROXIES}
      # Literal IPs and/or CIDR blocks, comma-separated. A malformed entry ABORTS STARTUP.
      # Bare, like every placeholder now: an unset variable must fail fast here, not boot unprotected.
      allowed-ips: ${WECMS_CALLBACK_ALLOWED_IPS}
    # EFS API connection.
    #
    # enabled=false SELECTS MockEfsApiClient, WHOSE send() THROWS. It is not a
    # quiet no-op client — @ConditionalOnProperty(havingValue="false",
    # matchIfMissing=true) makes it the default bean and every call raises
    # UnsupportedOperationException, so a live EFS request can never leave by
    # accident.
    #
    # Consequence: with EFS off, alerting and dispatch both fail LOUDLY rather
    # than going out. That is why alert.enabled=true above is safe to set ahead
    # of EFS — it converts silence into a visible WARN per alert instead of
    # delivering anything. The per-VAN API key is deliberately NOT config: it
    # lives in TB_VAN_API_INFO and VanApiKeyService throws when the row is
    # missing, so crypto can never run on a money-moving path with an absent key.
    # Do not add a WECMS_EFS_API_KEY variable.
    #
    # The two timeouts are hardcoded, not variables — they feed the lock-ceiling
    # arithmetic on result-check.batch-size above.
    efs:
      enabled: ${WECMS_EFS_ENABLED}
      base-url: ${WECMS_EFS_BASE_URL}
      connect-timeout-ms: 3000
      read-timeout-ms: 20000
    # SFTP file transfer.
    sftp:
      enabled: ${WECMS_SFTP_ENABLED}
      host: ${WECMS_SFTP_HOST}
      port: ${WECMS_SFTP_PORT}
      username: ${WECMS_SFTP_USERNAME}
      private-key-path: ${WECMS_SFTP_KEY_PATH}
      password: ${WECMS_SFTP_PASSWORD}
      connect-timeout-ms: 60000
      local-upload-path: ${WECMS_SFTP_LOCAL_UPLOAD}
      remote-upload-path: ${WECMS_SFTP_REMOTE_UPLOAD}
      local-download-path: ${WECMS_SFTP_LOCAL_DOWNLOAD}
      remote-download-path: ${WECMS_SFTP_REMOTE_DOWNLOAD}
      remote-move-path: ${WECMS_SFTP_REMOTE_MOVE}

  # File storage roots per upload module.
  overseas-payment:
    storage-root: ${WECMS_OVERSEAS_PAYMENT_STORAGE_ROOT}
  vendor-payment:
    storage-root: ${WECMS_VENDOR_PAYMENT_STORAGE_ROOT}
  expense-payment:
    storage-root: ${WECMS_EXPENSE_PAYMENT_STORAGE_ROOT}
  payroll:
    storage-root: ${WECMS_PAYROLL_STORAGE_ROOT}
  contacts:
    storage-root: ${WECMS_CONTACTS_STORAGE_ROOT}
  preferences:
    storage-root: ${WECMS_PREFERENCES_STORAGE_ROOT}
  user-image:
    storage-root: ${WECMS_USER_IMAGE_STORAGE_ROOT}
  erp-transaction-history:
    storage-root: ${WECMS_ERP_TRANSACTION_HISTORY_STORAGE_ROOT}
  card-transactions:
    storage-root: ${WECMS_CARD_TRANSACTIONS_STORAGE_ROOT}
  internal-transfer:
    storage-root: ${WECMS_INTERNAL_TRANSFER_STORAGE_ROOT}

  # Exchange rate collection.
  exchange-rate:
    # Scheduled collection batch.
    batch:
      enabled: ${WECMS_EXCHANGE_RATE_BATCH_ENABLED}
  # Operation status inquiry.
  operation-status:
    # Scheduled inquiry batch.
    batch:
      enabled: ${WECMS_OPERATION_STATUS_BATCH_ENABLED}
      # Single cron: seed then refresh run as ONE locked, ordered unit (see
      # OperationStatusBatchScheduler). Never-fire in the shipped .env — the real legacy
      # instant is UNRESOLVED (OQ-3: legacy DEV fired 15:00:01 UTC = 22:00 ICT =
      # 00:00 Asia/Seoul; the old placeholder assumed 00:00 ICT). Do not guess:
      # set WECMS_OPERATION_STATUS_BATCH_CRON only after the legacy batch owner or
      # Infra confirms the JEX Batch Admin entry AND its timezone.
      cron: "${WECMS_OPERATION_STATUS_BATCH_CRON}"
  # Coocon API integration.
  coocon:
    api-key: ${WECMS_COOCON_API_KEY}
    api-url: ${WECMS_COOCON_API_URL}
    smart-api-key: ${WECMS_COOCON_SMART_API_KEY}
    smart-api-url: ${WECMS_COOCON_SMART_API_URL}
    unique-key: ${WECMS_COOCON_UNIQUE_KEY}
  # OSMC API integration.
  osmc:
    url: ${WECMS_OSMC_URL}
    api-key: ${WECMS_OSMC_API_KEY}
    api-id: ${WECMS_OSMC_API_ID}
    unique-key: ${WECMS_OSMC_UNIQUE_KEY}

# =============================================================================
# Haengsung ERP integration
# Configures the Oracle connection and scheduled synchronization jobs.
# =============================================================================
haengsung:
  # Oracle database connection.
  oracle:
    enabled: ${HAENGSUNG_ORACLE_ENABLED}
    url: ${HAENGSUNG_ORACLE_URL}
    username: ${HAENGSUNG_ORACLE_USERNAME}
    password: ${HAENGSUNG_ORACLE_PASSWORD}
  # Scheduled payment import.
  scheduled-payment-import:
    enabled: ${HAENGSUNG_SCHEDULED_IMPORT_ENABLED}
    cron: "${HAENGSUNG_SCHEDULED_IMPORT_CRON}"
  # Exchange rate synchronization.
  exchange-rate-sync:
    enabled: ${HAENGSUNG_EXCHANGE_RATE_SYNC_ENABLED}
    cron: "${HAENGSUNG_EXCHANGE_RATE_SYNC_CRON}"
  # Card and account synchronization.
  card-account-sync:
    enabled: ${HAENGSUNG_CARD_ACCOUNT_SYNC_ENABLED}
    cron: "${HAENGSUNG_CARD_ACCOUNT_SYNC_CRON}"

# =============================================================================
# Application logging
# Configures application, security, Hibernate, and SQL logging levels.
# =============================================================================
logging:
  level:
    com.kosign.wecms: DEBUG
    org.springframework.security: WARN
    org.hibernate: info
    org.hibernate.SQL: DEBUG
    org.springframework.jdbc.core: TRACE
    org.springframework.jdbc.core.StatementCreatorUtils: TRACE
    org.hibernate.orm.jdbc.bind: TRACE

!.env.example
# Tracked templates: every committed *.example stays in git; real per-profile
# .env files (.env.local / .env.sit / .env.uat / .env.prod) remain ignored.
!.env.*.example

# HAENGSUNG Oracle credential handoff files — NEVER commit. Only the
# placeholder env templates (.env.sit.example) carry Oracle keys.
SIT oracle db.txt
*oracle*db*.txt
*oracle*.secret


# UAT profile template → copy to .env.uat (gitignored).
# On the real UAT host values come from the process env / secret store.
# Comments must be on their own line (no inline "# ..." after a value).

# ── Database ────────────────────────────────────────────────────────────────
WECMS_DB_URL=jdbc:postgresql://<uat-db-host>:5432/<uat-db>
WECMS_DB_USERNAME=<uat-db-user>
WECMS_DB_PASSWORD=

# ── JWT ─────────────────────────────────────────────────────────────────────
# >=32 bytes (HS256), >=64 bytes (HS512). openssl rand -hex 64
WECMS_JWT_SECRET=

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated exact origins.
WECMS_CORS_ALLOWED_ORIGINS=https://<uat-frontend-origin>

# ── Coocon (bank/card scraping + FX) ────────────────────────────────────────
# Keys are secrets. URLs point at the PROD/UAT gateway.
WECMS_COOCON_API_KEY=
WECMS_COOCON_API_URL=https://sgw.webcashvietnam.com/overseas/finance/scrap/bigdata_info.jsp
WECMS_COOCON_SMART_API_KEY=
WECMS_COOCON_SMART_API_URL=https://sgw.webcashvietnam.com/domestic/finance/scrap/smart_gateway.jsp
WECMS_COOCON_UNIQUE_KEY=

# ── OSMC (GDT lookup) ───────────────────────────────────────────────────────
WECMS_OSMC_URL=https://sgw.webcashvietnam.com/overseas/finance/scrap/bigdata_info.jsp
WECMS_OSMC_API_KEY=
WECMS_OSMC_API_ID=BI09
WECMS_OSMC_UNIQUE_KEY=

# ── Login Credentials ───────────────────────────────────────────────────────
# GDT verify-before-save. true | false
WECMS_LOGIN_CREDENTIALS_GDT_VERIFY_ENABLED=false

# ── Exchange Rate Batch ─────────────────────────────────────────────────────
# true | false. Enable in exactly one environment that owns FX collection.
WECMS_EXCHANGE_RATE_BATCH_ENABLED=false

# ── Operation Status Batch ──────────────────────────────────────────────────
# true | false + Spring cron (ICT).
WECMS_OPERATION_STATUS_BATCH_ENABLED=false
WECMS_OPERATION_STATUS_BATCH_SEED_CRON=0 0 0 * * ?
WECMS_OPERATION_STATUS_BATCH_REFRESH_CRON=0 0 0 * * ?

# ── Dispatch (firm-banking via EFS/VAN) ─────────────────────────────────────
# Flags true | false; cron "-" = never fire.
WECMS_DISPATCH_AUTO_RECEIVE=false
WECMS_DISPATCH_REALTIME_DISPATCH=false
WECMS_DISPATCH_RECIPIENT_INQUIRY=false
WECMS_DISPATCH_RESULT_CHECK_CRON=-
WECMS_DISPATCH_ALERT_ENABLED=false
# Inbound callback source-IP allow-list (empty = none).
WECMS_CALLBACK_ALLOWED_IPS=

# ── EFS / VAN gateway ───────────────────────────────────────────────────────
# Used only when enabled=true.
WECMS_EFS_ENABLED=false
WECMS_EFS_BASE_URL=
WECMS_EFS_PARTNER_ID=

# ── SFTP (bulk-file channel) ────────────────────────────────────────────────
# Used only when enabled=true. LOCAL_* are staging dirs (send/receive), not
# BIZ_KEY folders — exclude them from tenant backup/migration scripts.
WECMS_SFTP_ENABLED=false
WECMS_SFTP_HOST=
WECMS_SFTP_PORT=3300
WECMS_SFTP_USERNAME=
WECMS_SFTP_KEY_PATH=
WECMS_SFTP_PASSWORD=
WECMS_SFTP_LOCAL_UPLOAD=/DATA/src-wecms/wecms-backend/upload-files/send
WECMS_SFTP_REMOTE_UPLOAD=sdata
WECMS_SFTP_LOCAL_DOWNLOAD=/DATA/src-wecms/wecms-backend/upload-files/receive
WECMS_SFTP_REMOTE_DOWNLOAD=rdata
WECMS_SFTP_REMOTE_MOVE=rdata/success

# ── Storage roots (one per upload module; real persistent disk) ──────────────
WECMS_INTERNAL_TRANSFER_STORAGE_ROOT=/DATA/src-wecms/wecms-backend/upload-files
WECMS_VENDOR_PAYMENT_STORAGE_ROOT=/DATA/src-wecms/wecms-backend/upload-files
WECMS_EXPENSE_PAYMENT_STORAGE_ROOT=/DATA/src-wecms/wecms-backend/upload-files
WECMS_PAYROLL_STORAGE_ROOT=/DATA/src-wecms/wecms-backend/upload-files
WECMS_OVERSEAS_PAYMENT_STORAGE_ROOT=/DATA/src-wecms/wecms-backend/upload-files
WECMS_CONTACTS_STORAGE_ROOT=/DATA/src-wecms/wecms-backend/upload-files
WECMS_PREFERENCES_STORAGE_ROOT=/DATA/src-wecms/wecms-backend/upload-files
WECMS_USER_IMAGE_STORAGE_ROOT=/DATA/src-wecms/wecms-backend/upload-files
WECMS_ERP_TRANSACTION_HISTORY_STORAGE_ROOT=/DATA/src-wecms/wecms-backend/upload-files
WECMS_CARD_TRANSACTIONS_STORAGE_ROOT=/DATA/src-wecms/wecms-backend/upload-files

# ── HAENGSUNG Oracle ERP ────────────────────────────────────────────────────
# Off by default. URL/USERNAME/PASSWORD required only when enabled=true.
HAENGSUNG_ORACLE_ENABLED=false
HAENGSUNG_ORACLE_URL=jdbc:oracle:thin:@//<uat-oracle-host>:1521/<service>
HAENGSUNG_ORACLE_USERNAME=<uat-oracle-user>
HAENGSUNG_ORACLE_PASSWORD=

HAENGSUNG_SCHEDULED_IMPORT_ENABLED=false
HAENGSUNG_SCHEDULED_IMPORT_CRON=0 */5 * * * *

HAENGSUNG_EXCHANGE_RATE_SYNC_ENABLED=false
HAENGSUNG_EXCHANGE_RATE_SYNC_CRON=0 */5 * * * *

HAENGSUNG_CARD_ACCOUNT_SYNC_ENABLED=false
HAENGSUNG_CARD_ACCOUNT_SYNC_CRON=0 */5 * * * *

# ── Credential cipher seed ──────────────────────────────────────────────────
# Must equal the legacy seed.
WECMS_CRYPTO_LEGACY_CERT_SEED=wabooksvn

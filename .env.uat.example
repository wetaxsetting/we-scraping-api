# =============================================================================
#  .env.uat.example  ->  copy to  .env.uat  (gitignored)
# =============================================================================
#  Loaded by the `uat` profile via spring.config.import. application-uat.yml (and
#  the base application.yml it inherits) hold ONLY bare ${WECMS_*} placeholders —
#  EVERY value below is REQUIRED (a missing typed/flag value fails fast at startup).
#  On a real UAT host these come from the process env / secret store, NOT this file.
#  Do NOT invent hosts/keys. .env is a properties file — comments on their own line
#  only (no inline "# ..." after a value).
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────
# Postgres JDBC. URL = jdbc:postgresql://<host>:<port>/<db>. PASSWORD is a secret.
WECMS_DB_URL=jdbc:postgresql://<uat-db-host>:5432/<uat-db>
WECMS_DB_USERNAME=<uat-db-user>
WECMS_DB_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────
# HS256/HS512 secret. >=32 bytes (>=64 -> HS512). Unique per env. openssl rand -hex 64
WECMS_JWT_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated EXACT UAT frontend origin(s). Never "*".
WECMS_CORS_ALLOWED_ORIGINS=https://<uat-frontend-origin>

# ── Coocon (smart-gateway: bank/card scraping + FX) ───────────────────────
# *_API_KEY / *_SMART_API_KEY are SECRETS. URLs target the PROD/UAT gateway host.
# UNIQUE_KEY is a non-secret Coocon client id.
WECMS_COOCON_API_KEY=
WECMS_COOCON_API_URL=https://sgw.webcashvietnam.com/overseas/finance/scrap/bigdata_info.jsp
WECMS_COOCON_SMART_API_KEY=
WECMS_COOCON_SMART_API_URL=https://sgw.webcashvietnam.com/domestic/finance/scrap/smart_gateway.jsp
WECMS_COOCON_UNIQUE_KEY=

# ── OSMC (GDT lookup; same Coocon bigdata gateway) ─────────────────────────
# API_KEY is a SECRET. URL/API_ID(BI09)/UNIQUE_KEY non-secret.
WECMS_OSMC_URL=https://sgw.webcashvietnam.com/overseas/finance/scrap/bigdata_info.jsp
WECMS_OSMC_API_KEY=
WECMS_OSMC_API_ID=BI09
WECMS_OSMC_UNIQUE_KEY=

# ── Login Credentials ─────────────────────────────────────────────────────
# GDT verify-before-save. true|false. Needs reachable GDT gateway + captcha chain.
WECMS_LOGIN_CREDENTIALS_GDT_VERIFY_ENABLED=false

# ── Exchange Rate Batch ───────────────────────────────────────────────────
# true|false. FX scraping batch (writes BANK_EXCH_RATE_INFM). Set true in EXACTLY
# ONE environment that owns FX collection; false otherwise to avoid double-write.
WECMS_EXCHANGE_RATE_BATCH_ENABLED=false

# ── Operation Status Inquiry Batch ────────────────────────────────────────
# true|false. GDT operating-status sweep (legacy OPRT_0001_001 seed /
# OPRT_0010_001 refresh; writes OPRT_STTS_INFO). OFF everywhere — legacy JEX
# batch still owns that table on the shared DB. Crons match the confirmed legacy
# Batch Admin schedule: once a day at 00:00 ICT.
WECMS_OPERATION_STATUS_BATCH_ENABLED=false
WECMS_OPERATION_STATUS_BATCH_SEED_CRON=0 0 0 * * ?
WECMS_OPERATION_STATUS_BATCH_REFRESH_CRON=0 0 0 * * ?

# ── Dispatch (firm-banking payment dispatch via EFS/VAN) ───────────────────
# Flags true|false; cron is a Spring cron expr or "-" (= never fire). Keep OFF
# until SFTP+EFS+VAN are provisioned. Depends on the EFS + SFTP groups below.
# AUTO_RECEIVE: File-path dispatch -> 00301 reception (needs SFTP+EFS)
WECMS_DISPATCH_AUTO_RECEIVE=false
# REALTIME_DISPATCH: real-time 202 dispatch, VND/API (needs VAN keys+EFS)
WECMS_DISPATCH_REALTIME_DISPATCH=false
# RECIPIENT_INQUIRY: depositor-name inquiry WGVN_EFS_201 (needs VAN+EFS)
WECMS_DISPATCH_RECIPIENT_INQUIRY=false
# RESULT_CHECK_CRON: poll; set a cron only in the env owning realtime traffic
WECMS_DISPATCH_RESULT_CHECK_CRON=-
# ALERT_ENABLED: ops Slack alert WGVN_MSG_SEND_001 (legacy MsgSendUtil); ops-only, reuses EFS gateway + per-VAN key
WECMS_DISPATCH_ALERT_ENABLED=false
# CALLBACK_ALLOWED_IPS: inbound EFS callback source-IP allow-list (comma-separated); empty = no IP gate (rely on VV crypto)
WECMS_CALLBACK_ALLOWED_IPS=

# ── EFS / VAN gateway ─────────────────────────────────────────────────────
# ENABLED true|false (false = mock/inert). BASE_URL = gateway host. PARTNER_ID
# from ops. Used only when ENABLED=true. Per-VAN API key lives in TB_VAN_API_INFO.
# (EFS connect/read timeouts are fixed vendor constants in YAML, not env vars.)
WECMS_EFS_ENABLED=false
WECMS_EFS_BASE_URL=
WECMS_EFS_PARTNER_ID=

# ── SFTP (bulk-file channel: 00301 upload / 01302 result download) ─────────
# ENABLED true|false (false = MockSftp). KEY_PATH = private-key file (never commit
# the key); PASSWORD secret alt. REMOTE_* legacy dirs; PORT legacy 3300. Used only
# when ENABLED=true. (SFTP connect timeout is a fixed constant in YAML.)
#
# LOCAL_UPLOAD / LOCAL_DOWNLOAD are local staging dirs (JSch stages the 00301 file
# before upload and the 01302 result after download). They live INSIDE the upload
# root as sibling folders `send` / `receive` (must be real, writable by the app user).
# OPERATIONAL NOTE: `send` and `receive` are SFTP staging folders, NOT BIZ_KEY
# folders. Backup / migration scripts that iterate <upload-root>/* MUST exclude
# `send` and `receive` and must never treat them as tenant directories.
WECMS_SFTP_ENABLED=false
WECMS_SFTP_HOST=
WECMS_SFTP_PORT=3300
WECMS_SFTP_USERNAME=
WECMS_SFTP_KEY_PATH=
WECMS_SFTP_PASSWORD=
WECMS_SFTP_LOCAL_UPLOAD=/DATA/src-wecms/wecms-backend/upload-files/send
WECMS_SFTP_REMOTE_UPLOAD=sdata
WECMS_SFTP_LOCAL_DOWNLOAD=/DATA/src-wecms/wecms-backend/upload-files/receive
WECMS_SFTP_REMOTE_DOWNLOAD=rdata
WECMS_SFTP_REMOTE_MOVE=rdata/success

# ── Storage Roots (file uploads; layout <root>/<bizKey>/<module>/<file>) ────
# One root per upload module; point at real persistent disk (never ./tmp).
# Root = the deployed backend upload dir. The app appends /<BIZ_KEY>/<module>/<file>;
# only real BIZ_KEY folders (plus the SFTP `send`/`receive` staging siblings above)
# live directly under this root.
WECMS_INTERNAL_TRANSFER_STORAGE_ROOT=/DATA/src-wecms/wecms-backend/upload-files
WECMS_VENDOR_PAYMENT_STORAGE_ROOT=/DATA/src-wecms/wecms-backend/upload-files
WECMS_EXPENSE_PAYMENT_STORAGE_ROOT=/DATA/src-wecms/wecms-backend/upload-files
WECMS_PAYROLL_STORAGE_ROOT=/DATA/src-wecms/wecms-backend/upload-files
WECMS_OVERSEAS_PAYMENT_STORAGE_ROOT=/DATA/src-wecms/wecms-backend/upload-files
WECMS_CONTACTS_STORAGE_ROOT=/DATA/src-wecms/wecms-backend/upload-files
WECMS_PREFERENCES_STORAGE_ROOT=/DATA/src-wecms/wecms-backend/upload-files
WECMS_USER_IMAGE_STORAGE_ROOT=/DATA/src-wecms/wecms-backend/upload-files
WECMS_ERP_TRANSACTION_HISTORY_STORAGE_ROOT=/DATA/src-wecms/wecms-backend/upload-files
# Card Transactions receipt / e-Invoice attachments (BUSA_DOC_FILE). Point at persistent disk.
WECMS_CARD_TRANSACTIONS_STORAGE_ROOT=/DATA/src-wecms/wecms-backend/upload-files

# ── HAENGSUNG Oracle ERP integration (PRDT_TYPE='H') ───────────────────────
# Secondary, OPTIONAL Oracle datasource. ENABLED true|false (default false).
# URL/USERNAME/PASSWORD are SECRETS — required only when ENABLED=true (fail-fast).
# Never commit real values; placeholders only. URL: jdbc:oracle:thin:@//<host>:1521/<service>.
# Schedulers OFF by default; *_CRON is a Spring cron expr (ICT), 5-min default.
HAENGSUNG_ORACLE_ENABLED=false
HAENGSUNG_ORACLE_URL=jdbc:oracle:thin:@//<uat-oracle-host>:1521/<service>
HAENGSUNG_ORACLE_USERNAME=<uat-oracle-user>
HAENGSUNG_ORACLE_PASSWORD=

HAENGSUNG_SCHEDULED_IMPORT_ENABLED=false
HAENGSUNG_SCHEDULED_IMPORT_CRON=0 */5 * * * *

HAENGSUNG_EXCHANGE_RATE_SYNC_ENABLED=false
HAENGSUNG_EXCHANGE_RATE_SYNC_CRON=0 */5 * * * *

HAENGSUNG_CARD_ACCOUNT_SYNC_ENABLED=false
HAENGSUNG_CARD_ACCOUNT_SYNC_CRON=0 */5 * * * *

# ── Credential cipher seed (legacy pgcrypto compatibility CONSTANT) ────────
# AES key-derivation seed for BANK_CERT_INFO / GDT_CERT_INFO. Cross-system
# CONSTANT — MUST equal the legacy seed everywhere or cert data can't be shared.
# uat inherits the base application.yml default (wabooksvn); set this only to
# override it. Keep the value equal to the legacy seed.
WECMS_CRYPTO_LEGACY_CERT_SEED=wabooksvn

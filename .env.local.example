# =============================================================================
#  .env.local.example  ->  copy to  .env.local  (gitignored)
# =============================================================================
#  Loaded by the `local` profile via spring.config.import in application.yml.
#  application-local.yml holds ONLY bare ${WECMS_*} placeholders, so EVERY value
#  below is required (a missing typed/flag value fails fast at startup).
#  Setup: copy this file to .env.local, set WECMS_DB_PASSWORD, `./gradlew bootRun`.
#  OS environment variables always override .env files. Never commit .env.local.
#  NOTE: .env is a properties file — comments MUST be on their own line (no inline
#  "# ..." after a value, or it becomes part of the value).
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────
# Postgres JDBC connection. URL format: jdbc:postgresql://<host>:<port>/<db>.
# Host+user are non-secret shared-dev infra; PASSWORD is a secret (handoff only).
WECMS_DB_URL=jdbc:postgresql://172.168.5.172:5432/wecmsdevdb
WECMS_DB_USERNAME=wecmsdev_owner
WECMS_DB_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────
# HS256/HS512 signing secret. >=32 bytes (HS256); >=64 bytes -> HS512 (preferred).
# Generate a real one with: openssl rand -hex 64. Value below is a dev-only
# throwaway — NEVER reuse outside a laptop. The retired dev placeholder is blocklisted.
WECMS_JWT_SECRET=local-dev-only-insecure-jwt-secret-do-not-use-outside-laptop-hs512-0123456789

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated EXACT allowed origins (scheme+host+port). Never "*".
# Local set = Next.js dev + SIT frontend + the sample.coocon.co.kr NXiSAS alias.
WECMS_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://wecms.kosign.dev,http://sample.coocon.co.kr:3000

# ── Coocon (smart-gateway: bank/card scraping + FX rate) ───────────────────
# *_API_* = bigdata API; *_SMART_API_* = smart-gateway (drives scraping + FX).
# Keys are SECRETS (dummy here so local boots; set real DEV keys only to exercise
# scraping). URLs target the DEV host. UNIQUE_KEY is a non-secret client id.
WECMS_COOCON_API_KEY=dev-local-unused
WECMS_COOCON_API_URL=https://dev2.coocon.co.kr:8443/overseas/finance/scrap/bigdata_info.jsp
WECMS_COOCON_SMART_API_KEY=dev-local-unused
WECMS_COOCON_SMART_API_URL=https://dev-sgw.webcashvietnam.com:8443/domestic/finance/scrap/smart_gateway.jsp
WECMS_COOCON_UNIQUE_KEY=0000099

# ── OSMC (GDT business-registration lookup; same Coocon bigdata gateway) ────
# URL/API_ID/UNIQUE_KEY non-secret; API_KEY is a SECRET (dummy locally). Point
# URL+KEY at the DEV bigdata host or GDT lookup returns "unregistered key".
WECMS_OSMC_URL=https://dev2.coocon.co.kr:8443/overseas/finance/scrap/bigdata_info.jsp
WECMS_OSMC_API_KEY=dev-local-unused
WECMS_OSMC_API_ID=BI09
WECMS_OSMC_UNIQUE_KEY=0000099

# ── Login Credentials ─────────────────────────────────────────────────────
# GDT (tax-portal) verify-before-save. Values: true | false. Keep false on local:
# needs a reachable GDT gateway + the captcha challenge-chain (not yet shipped).
WECMS_LOGIN_CREDENTIALS_GDT_VERIFY_ENABLED=false

# ── Exchange Rate Batch ───────────────────────────────────────────────────
# Values: true | false. Enables the Shinhan+Woori FX scraping @Scheduled job
# (writes BANK_EXCH_RATE_INFM via Coocon). false on a laptop — only the env that
# OWNS FX collection (SIT) sets true, else dev boxes double-write/race the shared DB.
WECMS_EXCHANGE_RATE_BATCH_ENABLED=false

# ── Dispatch (firm-banking payment dispatch via EFS/VAN) ───────────────────
# Each flag is true|false; the cron is a Spring cron expr or "-" (= never fire).
# All stay false/"-" until SFTP+EFS+VAN are provisioned (inert/mock on a laptop).
# Depends on the EFS + SFTP groups below.
# AUTO_RECEIVE: File-path dispatch -> 00301 reception (needs SFTP+EFS)
WECMS_DISPATCH_AUTO_RECEIVE=false
# REALTIME_DISPATCH: real-time 202 dispatch, VND/API path (needs VAN keys+EFS)
WECMS_DISPATCH_REALTIME_DISPATCH=false
# RECIPIENT_INQUIRY: depositor-name inquiry WGVN_EFS_201 (needs VAN+EFS)
WECMS_DISPATCH_RECIPIENT_INQUIRY=false
# RESULT_CHECK_CRON: result-check poll; set a cron only in the env owning realtime traffic
WECMS_DISPATCH_RESULT_CHECK_CRON=-
# CALLBACK_ALLOWED_IPS: inbound EFS callback source-IP allow-list (comma-separated); empty = no IP gate (rely on VV crypto)
WECMS_CALLBACK_ALLOWED_IPS=

# ── EFS / VAN gateway ─────────────────────────────────────────────────────
# ENABLED true|false (false = mock, inert). BASE_URL = gateway host (DEV shown).
# PARTNER_ID is provisioned by ops. Used only when ENABLED=true. The per-VAN API
# key is NOT here — it lives in TB_VAN_API_INFO.
WECMS_EFS_ENABLED=false
WECMS_EFS_BASE_URL=https://dev-van-gw.webcashvietnam.com
WECMS_EFS_PARTNER_ID=

# ── SFTP (bulk-file channel: 00301 upload / 01302 result download) ─────────
# ENABLED true|false (false = MockSftp, no network I/O). KEY_PATH points at a
# private-key file (key material NEVER committed); PASSWORD is a secret alt.
# REMOTE_* are legacy dir names. PORT legacy = 3300. Used only when ENABLED=true.
WECMS_SFTP_ENABLED=false
WECMS_SFTP_HOST=
WECMS_SFTP_PORT=3300
WECMS_SFTP_USERNAME=
WECMS_SFTP_KEY_PATH=
WECMS_SFTP_PASSWORD=
WECMS_SFTP_LOCAL_UPLOAD=
WECMS_SFTP_REMOTE_UPLOAD=sdata
WECMS_SFTP_LOCAL_DOWNLOAD=
WECMS_SFTP_REMOTE_DOWNLOAD=rdata
WECMS_SFTP_REMOTE_MOVE=rdata/success

# ── Storage Roots (file uploads; layout <root>/<bizKey>/<module>/<file>) ────
# One root per upload module. On a laptop one shared folder suffices; on a server
# point at persistent disk (never ./tmp). Each must exist + be writable.
WECMS_INTERNAL_TRANSFER_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_VENDOR_PAYMENT_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_EXPENSE_PAYMENT_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_PAYROLL_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_OVERSEAS_PAYMENT_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_CONTACTS_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_PREFERENCES_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_USER_IMAGE_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_ERP_TRANSACTION_HISTORY_STORAGE_ROOT=C:/WECMS PROJECT/File Data

# ── HAENGSUNG Oracle ERP integration (PRDT_TYPE='H') ───────────────────────
# Secondary, OPTIONAL Oracle datasource. ENABLED true|false (default false).
# Host+user are non-secret dev infra (like the Postgres block above); PASSWORD
# is a secret (handoff only). Required only when ENABLED=true (fail-fast).
# Schedulers OFF by default; *_CRON is a Spring cron expr (ICT), 5-min default.
HAENGSUNG_ORACLE_ENABLED=false
HAENGSUNG_ORACLE_URL=jdbc:oracle:thin:@//172.168.5.23:1521/DEV
HAENGSUNG_ORACLE_USERNAME=wecms
HAENGSUNG_ORACLE_PASSWORD=

HAENGSUNG_SCHEDULED_IMPORT_ENABLED=false
HAENGSUNG_SCHEDULED_IMPORT_CRON=0 */5 * * * *

HAENGSUNG_EXCHANGE_RATE_SYNC_ENABLED=false
HAENGSUNG_EXCHANGE_RATE_SYNC_CRON=0 */5 * * * *

HAENGSUNG_CARD_ACCOUNT_SYNC_ENABLED=false
HAENGSUNG_CARD_ACCOUNT_SYNC_CRON=0 */5 * * * *

# ── Credential cipher seed (legacy pgcrypto compatibility CONSTANT) ────────
# AES key-derivation seed for BANK_CERT_INFO / GDT_CERT_INFO. Cross-system
# CONSTANT — MUST equal the legacy seed everywhere or cert data can't be shared.
# application-local.yml binds it bare (${WECMS_CRYPTO_LEGACY_CERT_SEED}), so this
# line is REQUIRED here; keep the value `wabooksvn` unless the legacy seed changes.
WECMS_CRYPTO_LEGACY_CERT_SEED=wabooksvn

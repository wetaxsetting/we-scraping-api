# Local profile template → copy to .env.local (gitignored).
# Set WECMS_DB_PASSWORD, then `./gradlew bootRun`. OS env vars override .env files.
# Comments must be on their own line (no inline "# ..." after a value).

# ── Database ────────────────────────────────────────────────────────────────
WECMS_DB_URL=jdbc:postgresql://172.168.5.172:5432/wecmsdevdb
WECMS_DB_USERNAME=wecmsdev_owner
WECMS_DB_PASSWORD=

# ── JWT ─────────────────────────────────────────────────────────────────────
# >=32 bytes (HS256), >=64 bytes (HS512). Dev-only throwaway — never reuse.
WECMS_JWT_SECRET=local-dev-only-insecure-jwt-secret-do-not-use-outside-laptop-hs512-0123456789

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated exact origins.
WECMS_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://wecms.kosign.dev,http://sample.coocon.co.kr:3000

# ── Coocon (bank/card scraping + FX) ────────────────────────────────────────
# Keys are secrets (dummy here). URLs point at the DEV gateway.
WECMS_COOCON_API_KEY=dev-local-unused
WECMS_COOCON_API_URL=https://dev2.coocon.co.kr:8443/overseas/finance/scrap/bigdata_info.jsp
WECMS_COOCON_SMART_API_KEY=dev-local-unused
WECMS_COOCON_SMART_API_URL=https://dev-sgw.webcashvietnam.com:8443/domestic/finance/scrap/smart_gateway.jsp
WECMS_COOCON_UNIQUE_KEY=0000099

# ── OSMC (GDT lookup) ───────────────────────────────────────────────────────
WECMS_OSMC_URL=https://dev2.coocon.co.kr:8443/overseas/finance/scrap/bigdata_info.jsp
WECMS_OSMC_API_KEY=dev-local-unused
WECMS_OSMC_API_ID=BI09
WECMS_OSMC_UNIQUE_KEY=0000099

# ── Exchange Rate Batch ─────────────────────────────────────────────────────
# true | false. Off on local.
WECMS_EXCHANGE_RATE_BATCH_ENABLED=false

# ── Operation Status Batch ──────────────────────────────────────────────────
# true | false + Spring cron (ICT).
WECMS_OPERATION_STATUS_BATCH_ENABLED=false
WECMS_OPERATION_STATUS_BATCH_SEED_CRON=0 0 0 * * ?
WECMS_OPERATION_STATUS_BATCH_REFRESH_CRON=0 0 0 * * ?

# ── Dispatch (firm-banking via EFS/VAN) ─────────────────────────────────────
# Flags true | false; cron "-" = never fire. All off (mock) on local.
WECMS_DISPATCH_AUTO_RECEIVE=false
WECMS_DISPATCH_REALTIME_DISPATCH=false
WECMS_DISPATCH_RECIPIENT_INQUIRY=false
WECMS_DISPATCH_RESULT_CHECK_CRON=-
WECMS_DISPATCH_ALERT_ENABLED=false
# Inbound callback source-IP allow-list (empty = none).
WECMS_CALLBACK_ALLOWED_IPS=

# ── EFS / VAN gateway ───────────────────────────────────────────────────────
# Used only when enabled=true.
WECMS_EFS_ENABLED=false
WECMS_EFS_BASE_URL=https://dev-van-gw.webcashvietnam.com
WECMS_EFS_PARTNER_ID=

# ── SFTP (bulk-file channel) ────────────────────────────────────────────────
# Used only when enabled=true. Never commit the key file.
WECMS_SFTP_ENABLED=false
WECMS_SFTP_HOST=
WECMS_SFTP_PORT=3300
WECMS_SFTP_USERNAME=
WECMS_SFTP_KEY_PATH=
WECMS_SFTP_PASSWORD=
WECMS_SFTP_LOCAL_UPLOAD=
WECMS_SFTP_REMOTE_UPLOAD=sdata
WECMS_SFTP_LOCAL_DOWNLOAD=
WECMS_SFTP_REMOTE_DOWNLOAD=rdata
WECMS_SFTP_REMOTE_MOVE=rdata/success

# ── Storage roots (one per upload module) ───────────────────────────────────
WECMS_INTERNAL_TRANSFER_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_VENDOR_PAYMENT_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_EXPENSE_PAYMENT_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_PAYROLL_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_OVERSEAS_PAYMENT_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_CONTACTS_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_PREFERENCES_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_USER_IMAGE_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_ERP_TRANSACTION_HISTORY_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_CARD_TRANSACTIONS_STORAGE_ROOT=C:/WECMS PROJECT/File Data

# ── HAENGSUNG Oracle ERP ────────────────────────────────────────────────────
# Off by default. PASSWORD required only when enabled=true. cron is Spring cron (ICT).
HAENGSUNG_ORACLE_ENABLED=false
HAENGSUNG_ORACLE_URL=jdbc:oracle:thin:@//172.168.5.23:1521/DEV
HAENGSUNG_ORACLE_USERNAME=wecms
HAENGSUNG_ORACLE_PASSWORD=

HAENGSUNG_SCHEDULED_IMPORT_ENABLED=false
HAENGSUNG_SCHEDULED_IMPORT_CRON=0 */5 * * * *

HAENGSUNG_EXCHANGE_RATE_SYNC_ENABLED=false
HAENGSUNG_EXCHANGE_RATE_SYNC_CRON=0 */5 * * * *

HAENGSUNG_CARD_ACCOUNT_SYNC_ENABLED=false
HAENGSUNG_CARD_ACCOUNT_SYNC_CRON=0 */5 * * * *

# ── Credential cipher seed ──────────────────────────────────────────────────
# Must equal the legacy seed. Keep `wabooksvn` unless the legacy seed changes.
WECMS_CRYPTO_LEGACY_CERT_SEED=wabooksvn

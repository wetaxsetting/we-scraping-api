# =============================================================================
#  .env.sit.example  ->  copy to  .env.sit  (gitignored)
# =============================================================================
#  Loaded by the `sit` profile via spring.config.import in application.yml.
#  application-sit.yml holds ONLY bare ${WECMS_*} placeholders — EVERY value below
#  is required (missing typed/flag value fails fast). On the real SIT host these
#  come from setenv.sh / OS env, NOT this file. Rotate the DEV keys still in git
#  history. .env is a properties file — comments on their own line only (no inline).
# =============================================================================

# ── Database (SIT shares the dev DB) ──────────────────────────────────────
# JDBC URL jdbc:postgresql://<host>:<port>/<db>. PASSWORD is a secret (handoff).
WECMS_DB_URL=jdbc:postgresql://<sit-db-host>:5432/<db>
WECMS_DB_USERNAME=<sit-db-user>
WECMS_DB_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────
# HS256/HS512 signing secret. >=32 bytes; >=64 -> HS512. Generate per env:
# openssl rand -hex 64. REQUIRED, unique per environment (no dev placeholder).
WECMS_JWT_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated EXACT allowed origins. Never "*". Add UAT origin if it points here.
WECMS_CORS_ALLOWED_ORIGINS=https://wecms.kosign.dev

# ── Coocon (smart-gateway: bank/card scraping + FX rate) ───────────────────
# Keys are SECRETS — REQUIRED on SIT (supply real DEV keys; rotate old ones).
# URLs target the DEV host (SIT uses the DEV gateway). UNIQUE_KEY non-secret.
WECMS_COOCON_API_KEY=
WECMS_COOCON_API_URL=https://dev2.coocon.co.kr:8443/overseas/finance/scrap/bigdata_info.jsp
WECMS_COOCON_SMART_API_KEY=
WECMS_COOCON_SMART_API_URL=https://dev-sgw.webcashvietnam.com:8443/domestic/finance/scrap/smart_gateway.jsp
WECMS_COOCON_UNIQUE_KEY=0000099

# ── OSMC (GDT lookup; same Coocon bigdata gateway) ─────────────────────────
# API_KEY is a SECRET (REQUIRED). URL/API_ID/UNIQUE_KEY non-secret.
WECMS_OSMC_URL=https://dev2.coocon.co.kr:8443/overseas/finance/scrap/bigdata_info.jsp
WECMS_OSMC_API_KEY=
WECMS_OSMC_API_ID=BI09
WECMS_OSMC_UNIQUE_KEY=0000099

# ── Login Credentials ─────────────────────────────────────────────────────
# GDT verify-before-save. true|false. Keep false until the GDT gateway is
# reachable from SIT AND the captcha challenge-chain ships.
WECMS_LOGIN_CREDENTIALS_GDT_VERIFY_ENABLED=false

# ── Exchange Rate Batch ───────────────────────────────────────────────────
# true|false. SIT OWNS FX collection (isolated refactor DB), so it is the one
# environment set to true; it runs the real Shinhan+Woori scraping batch.
WECMS_EXCHANGE_RATE_BATCH_ENABLED=true

# ── Banking Cutoff ────────────────────────────────────────────────────────
# Internal-transfer cut-off bank codes (constants; override only if they change).
WECMS_SHINHAN_BANK_CD=88886000
WECMS_WOORI_BANK_CD=11704000

# ── Dispatch (firm-banking payment dispatch via EFS/VAN) ───────────────────
# Flags true|false; cron is a Spring cron expr or "-" (= never fire). Keep OFF
# until SFTP+EFS+VAN are provisioned. Depends on EFS + SFTP groups below.
# AUTO_RECEIVE: File-path dispatch -> 00301 reception (needs SFTP+EFS)
WECMS_DISPATCH_AUTO_RECEIVE=false
# REALTIME_DISPATCH: real-time 202 dispatch, VND/API (needs VAN keys+EFS)
WECMS_DISPATCH_REALTIME_DISPATCH=false
# RECIPIENT_INQUIRY: depositor-name inquiry WGVN_EFS_201 (needs VAN+EFS)
WECMS_DISPATCH_RECIPIENT_INQUIRY=false
# RESULT_CHECK_CRON: poll; set a cron only in the env owning realtime traffic
WECMS_DISPATCH_RESULT_CHECK_CRON=-
# CALLBACK_ALLOWED_IPS: inbound EFS callback source-IP allow-list; empty = no IP gate (rely on VV crypto)
WECMS_CALLBACK_ALLOWED_IPS=

# ── EFS / VAN gateway ─────────────────────────────────────────────────────
# ENABLED true|false (false = mock). BASE_URL = gateway host. PARTNER_ID from ops.
# Used only when ENABLED=true. Per-VAN API key lives in TB_VAN_API_INFO.
WECMS_EFS_ENABLED=false
WECMS_EFS_BASE_URL=https://dev-van-gw.webcashvietnam.com
WECMS_EFS_PARTNER_ID=

# ── SFTP (bulk-file channel: 00301 upload / 01302 result download) ─────────
# ENABLED true|false (false = MockSftp). KEY_PATH = private-key file (never
# commit the key); PASSWORD secret alt. REMOTE_* legacy dirs. Used when ENABLED=true.
WECMS_SFTP_ENABLED=false
WECMS_SFTP_HOST=
WECMS_SFTP_PORT=3300
WECMS_SFTP_USERNAME=
WECMS_SFTP_KEY_PATH=
WECMS_SFTP_PASSWORD=
WECMS_SFTP_LOCAL_UPLOAD=
WECMS_SFTP_REMOTE_UPLOAD=sdata
WECMS_SFTP_LOCAL_DOWNLOAD=
WECMS_SFTP_REMOTE_DOWNLOAD=rdata
WECMS_SFTP_REMOTE_MOVE=rdata/success

# ── Storage Roots (file uploads; layout <root>/<bizKey>/<module>/<file>) ────
# One root per upload module — point at the SIT host's persistent disk. Samples
# below mirror the historical SIT layout; confirm the real path with ops.
WECMS_OVERSEAS_PAYMENT_STORAGE_ROOT=c:/WeCMS/File Data
WECMS_VENDOR_PAYMENT_STORAGE_ROOT=c:/WeCMS/File Data
WECMS_EXPENSE_PAYMENT_STORAGE_ROOT=c:/WeCMS/File Data
WECMS_PAYROLL_STORAGE_ROOT=c:/WeCMS/File Data
WECMS_INTERNAL_TRANSFER_STORAGE_ROOT=c:/WeCMS/File Data
WECMS_CONTACTS_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_PREFERENCES_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_USER_IMAGE_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_ERP_TRANSACTION_HISTORY_STORAGE_ROOT=C:/WECMS PROJECT/File Data

# =============================================================================
#  BATCH / DISPATCH VARIABLES — the narrative reference (what each flag does, the
#  audit findings behind it, the legacy-coexistence hazards, the activation gates)
#  lives at  docs/deployment/batch-dispatch-variable-reference.md
#  It is DOCUMENTATION ONLY — nothing loads it, and it does not belong on a server.
#  THIS file remains the authoritative checklist of what the profile requires.
#
#  .env.sit.example  ->  copy to  .env.sit  (gitignored)
# =============================================================================
#  CONSUMED BY: src/main/resources/application-sit.yml, plus application.yml (the
#  base profile, always active underneath it). The yml holds the SHAPE — every
#  value there is a ${VAR} placeholder, never a literal. Change values here.
#
#  THE RULE — EVERY VARIABLE IN THIS FILE IS REQUIRED.
#  As of 2026-07-30 the yml files carry NO defaults: every placeholder is bare
#  ${VAR}. So this file is not a menu of optional overrides — it is the complete,
#  authoritative CHECKLIST of what application-sit.yml (plus application.yml) needs.
#  72 variables. Omit one and the application does not start correctly.
#  See docs/deployment/config-bare-placeholder-migration.md.
#
#  Values below are the ones the yml used to default to, so copying this file
#  reproduces the previous behaviour exactly. Change a value deliberately, never by
#  deleting a line.
#
#  An empty value satisfies a String but NOT a boolean or an int
#  (WECMS_SFTP_PORT= fails to bind). Where the correct value IS empty
#  (WECMS_SFTP_USERNAME, WECMS_CALLBACK_TRUSTED_PROXIES, …) keep the line with
#  nothing after the '='. Do not delete it.
#
#  ACCURACY NOTE — a missing variable does not always announce itself. @Value and
#  @Scheduled properties abort naming it ("Could not resolve placeholder 'VAR'"),
#  but @ConfigurationProperties binds LENIENTLY and uses the literal text "${VAR}"
#  as the value: a boolean/int target then fails the bind (verified:
#  trust-forwarded-for → Value: "${WECMS_CALLBACK_TRUST_FORWARDED_FOR}"), while a
#  STRING target produces NO error and breaks later in a way that never mentions
#  the variable. A complete file therefore matters MORE, not less — diff the real
#  .env.sit against this template before deploying.
#
#  The 13 code-only properties at the end of this file are NOT covered by the rule:
#  they live only in code and are not read from here.
#
#  LOADING — AND WHY THIS FILE IS NOT THE RUNTIME AUTHORITY ON THE SIT HOST:
#  application-sit.yml imports it with spring.config.import prefixed "optional:",
#  so a MISSING .env.sit does NOT fail — the app boots, every default applies, and
#  it dies at the first unresolvable placeholder, with an error that never mentions the absent file. Since no placeholder has a default, that now happens almost immediately.
#  On the SIT host the real pair lives at
#    /DATA/src-wecms/wecms-backend/environment/
#  and is exported as OS environment variables by
#    /DATA/src-wecms/apache-tomcat-11.0.22/bin/setenv.sh
#  before Tomcat starts. setenv.sh is host-owned and NOT in this repository, and
#  OS env OVERRIDES .env files — so setenv.sh WINS on SIT. Never state SIT's flag
#  state from this repo; read it from the host with
#    env | grep -E '^(WECMS|HAENGSUNG)_'
#  This has already bitten: DB evidence showed recipient-inquiry and efs.enabled
#  live on a deployed SIT node while the committed files said false.
#
#  NO REAL SECRETS IN THIS FILE — it is committed. DB password, JWT secret,
#  Coocon/OSMC API keys, Oracle password and SFTP password are left empty on
#  purpose; provision them out-of-band into setenv.sh. Historically-committed DEV
#  Coocon keys remain an open rotation item. .gitignore excludes .env.* and
#  re-includes only *.example — keep it that way.
#
#  .env IS A PROPERTIES FILE — comments MUST be on their own line. An inline
#  "# ..." after a value becomes PART OF THE VALUE.
#
#  HOW THIS PROFILE DIFFERS: SIT and UAT are the two profiles with the read-only
#  stuck-monitor and ops alerting ON by default in the yml (FIX H / I / K,
#  2026-07-30). SIT differs from UAT only in alert env-mode (T vs U) and verbose
#  SQL logging. Every mutating dispatch leg is still off.
# =============================================================================

# =============================================================================
# Database
# PostgreSQL connection settings for the WeCMS application.
# =============================================================================
WECMS_DB_URL=jdbc:postgresql://<sit-db-host>:5432/<db>
WECMS_DB_USERNAME=<sit-db-user>
WECMS_DB_PASSWORD=

# =============================================================================
# JWT
# Signing secret for API authentication.
# =============================================================================
WECMS_JWT_SECRET=

# =============================================================================
# CORS
# Allowed cross-origin frontend origins.
# =============================================================================
WECMS_CORS_ALLOWED_ORIGINS=https://wecms.kosign.dev

# =============================================================================
# Coocon
# Gateway API settings for bank/card scraping and FX rates.
# =============================================================================
WECMS_COOCON_API_KEY=
WECMS_COOCON_API_URL=https://dev2.coocon.co.kr:8443/overseas/finance/scrap/bigdata_info.jsp
WECMS_COOCON_SMART_API_KEY=
WECMS_COOCON_SMART_API_URL=https://dev-sgw.webcashvietnam.com:8443/domestic/finance/scrap/smart_gateway.jsp
WECMS_COOCON_UNIQUE_KEY=0000099

# =============================================================================
# OSMC
# Gateway API settings for GDT lookup.
# =============================================================================
WECMS_OSMC_URL=https://dev2.coocon.co.kr:8443/overseas/finance/scrap/bigdata_info.jsp
WECMS_OSMC_API_KEY=
WECMS_OSMC_API_ID=BI09
WECMS_OSMC_UNIQUE_KEY=0000099

# =============================================================================
# Exchange rate batch
# Exchange rate collection batch settings.
# =============================================================================
# CORRECTED 2026-07-30: was `true`, which contradicted the real .env.sit (false since
# 2026-07-28) and the project rule that no scheduler may be enabled by committed
# config. SchedulerConfigurationContractTest now enforces that rule on this file, and
# this line was the one violation. `true` runs the real Shinhan+Woori FX scraping
# batch (writes BANK_EXCH_RATE_INFM via Coocon) and is safe ONLY after legacy
# EXCH_0001/0010/0020_001 are disabled in the same environment — ShedLock does not
# coordinate with the legacy JEX runtime, and the Woori leg has both sides computing
# SEQ_NO = MAX+1 cross-tenant with INSERT-only semantics.
WECMS_EXCHANGE_RATE_BATCH_ENABLED=false

# =============================================================================
# Operation status batch
# Operation status inquiry batch settings.
# =============================================================================
WECMS_OPERATION_STATUS_BATCH_ENABLED=false
# The key that IS read. "-" = never fire (Spring's marker). Required — the yml
# carries no default, so omitting this aborts startup. Set a real cron only after
# the legacy batch owner or Infra confirms the JEX Batch Admin entry AND its
# timezone (OQ-3 — the real legacy instant is still UNRESOLVED).
WECMS_OPERATION_STATUS_BATCH_CRON=-

# =============================================================================
# Dispatch
# Firm-banking dispatch settings through EFS and VAN Center.
# =============================================================================
# TURNING EVERY FLAG BELOW OFF DOES NOT MAKE THE SYSTEM INERT.
# These flags gate DISPATCH, not row creation. Saving a payment writes its
# TB_PAY_TARGET / TB_PAY_FILE_MST row with PROC_STAT='9' (WAIT) at request time,
# unconditionally — the five *DispatchExecutor classes consult no flag. Only the
# after-commit registrars read one, and all they decide is whether THIS
# application hands the row onward. On a SHARED JEX database the legacy batch
# (FILE_DEPOSIT_TRANSFER_BATCH1, schedule */1 * * * *) polls for exactly
# PROC_STAT='9' and WILL PICK IT UP AND SEND IT — within 60 seconds. "All our
# flags are off" is NOT the same statement as "no money moves". Establish which DB
# this environment points at before treating these flags as a safety control.
#
# "-" IS SPRING'S NEVER-FIRE MARKER and the only safe way to disable a cron. An
# EMPTY value or an invalid expression throws at scheduler init — the app fails to
# start. Never blank a cron to turn a job off; set it to "-".
#
# DB PRECONDITION: TB_BATCH_SCHEDULE_INFO / _DTL are seeded and verified on
# DEV/SIT (3 INFO + 12 DTL) but NOT on UAT/PROD. With no INFO row every bulk and
# realtime transfer fails immediately, before any gateway call. Do not seed by
# hand — Gate B of docs/deployment/wecms-batch-activation-runbook.md §5.0 owns it.
WECMS_DISPATCH_AUTO_RECEIVE=false
WECMS_DISPATCH_REALTIME_DISPATCH=false
WECMS_DISPATCH_RECIPIENT_INQUIRY=false
WECMS_DISPATCH_RESULT_CHECK_CRON=-
# Master gate for the result-check body. Also silences StrandedRecoveryService's
# fourth strand class (see application-sit.yml).
WECMS_DISPATCH_RESULT_CHECK_ENABLED=false
# Candidate rows per pass. COUPLED to ResultCheckJob's PT60M lockAtMostFor —
# recompute the ceiling if you raise this (ResultCheckLockCeilingTest guards it).
WECMS_DISPATCH_RESULT_CHECK_BATCH_SIZE=100

# R-1 stranded-record recovery sweep — MUTATING. Both gates must be opened
# together, and only in an environment whose DB is verified separate from the
# legacy JEX batch DB. DEV and SIT are verified DB-separated. "-" = never fire.
WECMS_DISPATCH_RECOVERY_ENABLED=false
WECMS_DISPATCH_RECOVERY_CRON=-
# Age in minutes before a '9'/'6' row is treated as stranded.
WECMS_DISPATCH_RECOVERY_GRACE_MINUTES=30

# Read-only stuck-pay-file monitor (refactor-only; no legacy twin). Safe to enable
# in SIT — it mutates nothing. Both gates must be opened together. The values below
# are the ones SIT's yml used to default to: after the batch-1 fail-closed fix this
# sweep is the ONLY detection for BULK_EXECUTION_UNCONFIRMED and
# BULK_EXECUTION_NOT_ISSUED, which resolve solely by operator action.
WECMS_DISPATCH_STUCK_MONITOR_ENABLED=true
WECMS_DISPATCH_STUCK_MONITOR_CRON=0 */5 * * * *
# Cap on the firm-file sweep, so monitoring cannot become an unbounded scan.
WECMS_DISPATCH_STUCK_MONITOR_FIRM_FILE_BATCH_SIZE=200
# How far back the firm-file sweep looks, on PROC_DTTM. 7 days, so a Friday-night
# strand is still reported on Monday.
WECMS_DISPATCH_STUCK_MONITOR_RETENTION_DAYS=7
# Gates EVERY ops alert in the dispatch package — one master gate inside
# OpsAlertService, all 11 producers behind it. With it false, every alert in the
# subsystem is a log line and nothing more; nobody is paged.
#
# NOTE this template ships false while SIT's yml used to default to TRUE (FIX I).
# That is not a behaviour change: an .env value always beat the yml default, so a
# host built from this template already had alerting off. Now that the yml carries
# no default, THIS LINE is the only thing deciding it — set it to true when the
# alert channel is meant to be live.
# Set true 2026-07-31 to match the live .env.sit (FIX I intent). Delivery still needs
# WECMS_EFS_ENABLED=true + a TB_VAN_API_INFO.API_KEY row; until then each alert is a
# swallowed WARN — detection reaches the log, not a person.
WECMS_DISPATCH_ALERT_ENABLED=true
# Legacy ENV_MODE marker (T=DEV / U=UAT / R=PROD) + WAS_NO, shown in the alert's
# ServerGB label. Blank was-no is valid; the label just omits the instance number.
WECMS_DISPATCH_ALERT_ENV_MODE=T
WECMS_DISPATCH_ALERT_WAS_NO=
# Gateway channel-mapping id. DO NOT change from WECMSBATCH before the VAN Center
# confirms a second channel is registered — an unregistered grpID most likely means
# the gateway drops the message silently (fire-and-forget; only a non-0000 RC logs).
WECMS_DISPATCH_ALERT_GRP_ID=WECMSBATCH
# Inbound EFS/VAN callback source-IP allow-list; literal IPs and/or CIDR,
# comma-separated. REQUIRED (bare) in this profile — an unset value fails startup
# rather than booting unprotected. A malformed entry ABORTS STARTUP. Under the sit
# default protection=ENFORCE an EMPTY list REJECTS every callback with 403 —
# fail-closed, and until the VAN Center supplies the real gateway IPs that is the
# intended behaviour, not a regression. X-Forwarded-For is honoured only when the
# immediate peer is listed in WECMS_CALLBACK_TRUSTED_PROXIES, so a forged header
# cannot influence the decision. The payload VV HMAC is a separate, unchanged gate.
WECMS_CALLBACK_ALLOWED_IPS=
# ENFORCE = fail closed: an empty or non-matching allow-list rejects with 403.
# Never set DISABLED on a deployed host (it is WARN-logged on every startup).
WECMS_CALLBACK_PROTECTION=ENFORCE
# Reverse proxies whose X-Forwarded-For may be believed. Literals and/or CIDR.
# EMPTY IS THE SAFE VALUE — set only if TLS terminates upstream of the app.
WECMS_CALLBACK_TRUSTED_PROXIES=
# Whether the header may be consulted at all. Necessary but not sufficient — the
# peer must also be in trusted-proxies above.
WECMS_CALLBACK_TRUST_FORWARDED_FOR=true

# =============================================================================
# EFS / VAN gateway
# EFS and VAN Center gateway connection settings.
# =============================================================================
# ENABLED=false SELECTS MockEfsApiClient, WHOSE send() THROWS — not a quiet no-op.
# Every call raises UnsupportedOperationException, so a live EFS request can never
# leave by accident, and alerting and dispatch both fail LOUDLY rather than going
# out. That is why the yml can safely default alerting ON here ahead of EFS: it
# converts silence into a visible WARN per alert instead of delivering anything.
# Real delivery needs THREE things: ALERT_ENABLED=true, EFS_ENABLED=true + a real
# base-url, and a TB_VAN_API_INFO.API_KEY row for the VAN_ORG_CD (provisioned on
# DEV/SIT). The per-VAN API key is deliberately NOT an environment variable — it
# lives in the DB and VanApiKeyService throws when the row is missing, so crypto
# can never run on a money-moving path with an absent key. Do not add a
# WECMS_EFS_API_KEY. The connect/read timeouts are hardcoded in the yml.
WECMS_EFS_ENABLED=false
WECMS_EFS_BASE_URL=https://dev-van-gw.webcashvietnam.com

# =============================================================================
# SFTP
# Bulk-file channel connection settings.
# =============================================================================
WECMS_SFTP_ENABLED=false
# Host + key path + the two LOCAL staging dirs are NON-SECRET and are taken from the
# live .env — an empty value here is not neutral. StringUtils.hasText("") is false, so
# a blank LOCAL_UPLOAD/LOCAL_DOWNLOAD silently falls back to java.io.tmpdir with NO log
# line at all (BulkReceptionService:851-853, BulkExecutionResultService:341-342) —
# payment request files and downloaded bank result files land in OS temp and are lost
# on restart. Confirm the paths with Ops before enabling SFTP; see
# docs/deployment/sit-bare-placeholder-deploy-checklist.md.
WECMS_SFTP_HOST=42.96.55.163
WECMS_SFTP_PORT=3300
WECMS_SFTP_USERNAME=
WECMS_SFTP_KEY_PATH=/home/was/.ssh/id_rsa
WECMS_SFTP_PASSWORD=
WECMS_SFTP_LOCAL_UPLOAD=/WAS_DATA/file/wecmsbatch/send
WECMS_SFTP_REMOTE_UPLOAD=sdata
WECMS_SFTP_LOCAL_DOWNLOAD=/WAS_DATA/file/wecmsbatch/receive
WECMS_SFTP_REMOTE_DOWNLOAD=rdata
WECMS_SFTP_REMOTE_MOVE=rdata/success

# =============================================================================
# File storage
# Storage root paths per upload module.
# =============================================================================
WECMS_OVERSEAS_PAYMENT_STORAGE_ROOT=c:/WeCMS/File Data
WECMS_VENDOR_PAYMENT_STORAGE_ROOT=c:/WeCMS/File Data
WECMS_EXPENSE_PAYMENT_STORAGE_ROOT=c:/WeCMS/File Data
WECMS_PAYROLL_STORAGE_ROOT=c:/WeCMS/File Data
WECMS_INTERNAL_TRANSFER_STORAGE_ROOT=c:/WeCMS/File Data
WECMS_CONTACTS_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_PREFERENCES_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_USER_IMAGE_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_ERP_TRANSACTION_HISTORY_STORAGE_ROOT=C:/WECMS PROJECT/File Data
WECMS_CARD_TRANSACTIONS_STORAGE_ROOT=C:/WECMS PROJECT/File Data

# =============================================================================
# Haengsung ERP
# Oracle connection and scheduled synchronization settings.
# =============================================================================
# Oracle database connection.
HAENGSUNG_ORACLE_ENABLED=false
HAENGSUNG_ORACLE_URL=jdbc:oracle:thin:@//<sit-oracle-host>:1521/<service>
HAENGSUNG_ORACLE_USERNAME=<sit-oracle-user>
HAENGSUNG_ORACLE_PASSWORD=

# Scheduled payment import.
HAENGSUNG_SCHEDULED_IMPORT_ENABLED=false
# Legacy ERP_0100_002.batch: schedule=*/5 7-19 * * *  (every 5 min, hours 07-19)
# CORRECTED 2026-07-31: was `0 */5 * * * *` (24 h). The 2026-07-28 legacy-parity
# correction was applied to .env.sit, .env.uat.example and .env.prod.example but this
# template was missed — same pattern as the stuck-monitor keys. Live .env.sit is the
# authority here, not this file.
HAENGSUNG_SCHEDULED_IMPORT_CRON=0 */5 7-19 * * ?

# Exchange rate synchronization.
HAENGSUNG_EXCHANGE_RATE_SYNC_ENABLED=false
# Legacy ERP_0100_001.batch: schedule=*/10 7-19 * * * (every 10 min, hours 07-19)
# CORRECTED 2026-07-31: was 0 */5 * * * * — 2x legacy rate across 24h. (The 07-28
# correction reached .env.sit and the uat/prod templates but missed this file.)
HAENGSUNG_EXCHANGE_RATE_SYNC_CRON=0 */10 7-19 * * ?

# Card and account synchronization.
HAENGSUNG_CARD_ACCOUNT_SYNC_ENABLED=false
# Legacy ERP_0100_003.batch: schedule=0 7-19 * * *      (HOURLY, hours 07-19)
# CORRECTED 2026-07-31: was 0 */5 * * * * — 288 fires/day vs legacy 13. (The 07-28
# correction reached .env.sit and the uat/prod templates but missed this file.)
HAENGSUNG_CARD_ACCOUNT_SYNC_CRON=0 0 7-19 * * ?

# =============================================================================
# Credential cipher
# Credential cipher seed for certificate encryption.
# =============================================================================
WECMS_CRYPTO_LEGACY_CERT_SEED=wabooksvn

# =============================================================================
# TUNABLE, BUT NOT CURRENTLY SET ANYWHERE — code defaults only
# =============================================================================
# The 13 properties below are read by the running application but appear in NO
# yml and NO .env. Their only value is the default hardcoded at the @Value /
# @ConfigurationProperties site, so a developer reading the configuration files
# has no way to learn that they exist or that they can be changed. They are
# recorded here for discoverability.
#
# THEY ARE COMMENTED OUT ON PURPOSE — uncommenting one does NOTHING. There is no
# ${VAR} placeholder in any yml to receive it. To make one configurable you must
# FIRST add the placeholder line to the profile yml(s), THEN set the variable
# here. A variable set here alone is inert.
#
# Format:  property = code default   (owning class)
#
# --- dispatch: stranded-recovery sweep -------------------------------------
#   wecms.dispatch.recovery.batch-size             = 50    StrandedRecoveryService
#
# --- dispatch: read-only stuck-pay-file monitor ----------------------------
#   wecms.dispatch.stuck-monitor.threshold-minutes = 15    StuckPayFileMonitorService
#       age a PROC_STAT='9' row must reach before it counts as stuck
#   wecms.dispatch.stuck-monitor.re-alert-minutes  = 60    StuckPayFileMonitorService
#       de-duplication window before the same fingerprint alerts again
#   wecms.dispatch.stuck-monitor.max-alert-keys    = 20    StuckPayFileMonitorService
#       cap on distinct keys named inside one aggregated alert
#   wecms.dispatch.stuck-monitor.pay-file-batch-size = 200 StuckPayFileMonitorService
#       cap on the FIRST (pay-file) sweep. NOTE its sibling
#       stuck-monitor.firm-file-batch-size IS in the yml and this one is not —
#       easy to change one and believe you changed both.
#
# --- dispatch: operating-hours gate ----------------------------------------
#   wecms.dispatch.operating-hours.zone = Asia/Ho_Chi_Minh OperatingHoursService
#       wall-clock zone the HHmmss TB_BATCH_SCHEDULE windows are evaluated in.
#       LEAVE AT ICT — these are Vietnamese bank cut-offs. Asia/Seoul only for
#       bug-for-bug parity with a co-hosted legacy JEX batch (the JEX frame DB
#       runs Asia/Seoul, so legacy reads 090000-153000 as 07:00-13:30 ICT).
#
# --- internal transfer: bank routing + cut-off -----------------------------
#   wecms.internal-transfer.routing.shinhan-bank-cd = 970424 InternalTransferDispatchExecutor
#   wecms.internal-transfer.routing.woori-bank-cd   = 970457 InternalTransferDispatchExecutor
#   wecms.internal-transfer.routing.vcb-bank-cd     = 970436 InternalTransferDispatchExecutor
#       these select the API-vs-file dispatch path and the matching cut-off
#       window. They are bank identities, not preferences — do not "tune" them.
#   wecms.internal-transfer.cutoff.refresh-interval-ms = 300000 CutoffConfigProvider
#       @Scheduled TTL re-read so a direct DBA SQL edit to the cut-off config
#       propagates without an app restart
#
# --- NXISAS bank-scraping client -------------------------------------------
#   wecms.nxisas.timeout-seconds      = 60   NxisasGatewayProperties
#   wecms.nxisas.session-idle-seconds = 300  NxisasGatewayProperties
#       legacy JEX values. The gateway URL and API key are NOT here — they are
#       wecms.coocon.smart-api-url / smart-api-key, shared with the FX endpoint.
#
# --- Own Account Transfer ---------------------------------------------------
#   wecms.oat.seed-decrypt.enabled = false  OatSeedDecryptProperties
#       B1 SEED-CBC decrypt of engine output; false = pre-B1 pass-through
# =============================================================================
